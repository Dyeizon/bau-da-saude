{
  "openapi": "3.0.1",
  "info": {
    "title": "API | Baú da Saúde",
    "version": "1.0.0",
    "description": "### Bem-vindo à documentação da API do Baú da Saúde\n\n#### Descrição\n\n Um serviço inovador projetado para facilitar o armazenamento, gerenciamento e acesso aos seus exames médicos de forma segura e eficiente. O Baú da Saúde é uma plataforma que visa centralizar todos os seus registros médicos em um único local, proporcionando praticidade tanto para pacientes quanto para profissionais de saúde."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Servidor local"
    },
    {
      "url": "https://baudasaude-api.vercel.app",
      "description": "Servidor"
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Cadastro um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso"
          },
          "400": {
            "description": "Erro na criação do usuário"
          }
        }
      },
      "get": {
        "summary": "Listar todos os usuários",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth": {
      "post": {
        "summary": "Login de um usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Solicita redefinição de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email de redefinição enviado"
          },
          "400": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "summary": "Verificar OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOTP"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP válido"
          },
          "400": {
            "description": "Token inválido ou expirado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Redefine a senha do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha redefinida com sucesso"
          },
          "400": {
            "description": "Token inválido ou expirado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/types": {
      "get": {
        "summary": "Listar todos os tipos de exames",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tipos de exames",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamType"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo tipo de exame",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de exame cadastrado com sucesso"
          },
          "400": {
            "description": "Erro no cadastro do tipo de exame"
          }
        }
      }
    },

    "/exams": {
      "post": {
        "summary": "Cadastrar um novo exame",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/NewExam"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exame cadastrado com sucesso"
          },
          "400": {
            "description": "Erro ao cadastrar exame: arquivo muito grande"
          },
          "500": {
            "description": "Erro ao cadastrar exame"
          }
        }
      }
    },
    "/exams/owner/{owner}": {
      "get": {
        "summary": "Listar todos os exames por proprietário",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do proprietário"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de exames do proprietário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Exams"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro ao buscar exames"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/exams/{id}": {
      "get": {
        "summary": "Obter detalhes de um exame",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do exame"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do exame",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exams"
                }
              }
            }
          },
          "400": {
            "description": "Erro ao buscar exame"
          }
        }
      },
      "delete": {
        "summary": "Deletar um exame por ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do exame"
          }
        ],
        "responses": {
          "200": {
            "description": "Exame deletado com sucesso"
          },
          "400": {
            "description": "Erro ao deletar exame"
          },
          "404": {
            "description": "Exame não encontrado ou não autorizado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/exams/download/{id}": {
      "get": {
        "summary": "Baixar arquivo do exame",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do exame"
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo do exame",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Erro ao baixar arquivo"
          },
          "404": {
            "description": "Arquivo não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/result-types": {
      "get": {
        "summary": "Listar todos os tipos de resultados",
        "responses": {
          "200": {
            "description": "Lista de tipos de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultType"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo tipo de resultado",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de resultado cadastrado com sucesso"
          },
          "400": {
            "description": "Erro no cadastro do tipo de resultado"
          }
        }
      }
      },
      "/result-types/delete-resulttype": {
      "delete": {
        "summary": "Deletar um tipo de resultado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "resulttype_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do tipo de resultado"
          },
          {
            "name": "resulttype_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Nome do tipo de resultado"
          }
          
          
        ],
        "responses": {
          "200": {
            "description": "Tipo de resultado deletado com sucesso"
          },
          "400": {
            "description": "Erro ao deletar tipo de resultado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    }
  
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": ["name", "email", "password", "birthDate"]
      },
      "auth": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "ForgotPassword": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": ["email"]
      },
      "VerifyOTP": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token OTP"
          },
          "email": {
            "type": "string",
            "description": "Email do usuário"
          }
        },
        "required": ["token", "email"]
      },
      "ResetPassword": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
        "email": {
            "type": "string"
        }
          },
        "required": ["token", "password", "email"]
      },

      "ExamType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ResultType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "measure": {
            "type": "string"
          }
        }
      },
      "Exams": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "examName": {
            "type": "string"
          },
          "examDate": {
            "type": "string",
            "format": "date"
          },
          "examType": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selectedName": {
                  "type": "string"
                },
                "resultValue": {
                  "type": "string"
                },
                "selectedMeasure": {
                  "type": "string"
                }
              }
            }
          },
        "file": {
            "type": "string",
            "format": "binary"
          },
          "contentType": {
            "type": "string"
          }
        }
        
      },
      "NewExam": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "examName": {
            "type": "string"
          },
          "examDate": {
            "type": "string",
            "format": "date"
          },
          "examType": {
            "type": "string"
          },
          "results": {
            "type": "string",
            "description": "JSON string representing the results array"
          },
          "examFile": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "DeleteExamType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "DeleteResultType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
