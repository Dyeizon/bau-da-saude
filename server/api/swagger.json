{
  "openapi": "3.0.1",
  "info": {
    "title": "API | Baú da Saúde",
    "version": "1.0.0",
    "description": "### Bem-vindo à documentação da API do Baú da Saúde\n\n#### Descrição\n\n Um serviço inovador projetado para facilitar o armazenamento, gerenciamento e acesso aos seus exames médicos de forma segura e eficiente. O Baú da Saúde é uma plataforma que visa centralizar todos os seus registros médicos em um único local, proporcionando praticidade tanto para pacientes quanto para profissionais de saúde."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Servidor local"
    },
    {
      "url": "https://baudasaude-api.vercel.app",
      "description": "Servidor"
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Cadastro um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso"
          },
          "400": {
            "description": "Erro na criação do usuário"
          }
        }
      },
      "get": {
        "summary": "Listar todos os usuários",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth": {
      "post": {
        "summary": "Login de um usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Solicita redefinição de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email de redefinição enviado"
          },
          "400": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/auth/reset-password/{token}": {
      "post": {
        "summary": "Redefine a senha do usuário",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha redefinida com sucesso"
          },
          "400": {
            "description": "Token inválido ou expirado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/types": {
      "get": {
        "summary": "Listar todos os tipos de exames",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tipos de exames",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamType"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo tipo de exame",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de exame cadastrado com sucesso"
          },
          "400": {
            "description": "Erro no cadastro do tipo de exame"
          }
        }
      }
    },
    "/exams": {
      "get": {
        "summary": "Listar todos os exames",
        "responses": {
          "200": {
            "description": "Lista de exames",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Exams"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro ao buscar exames"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo exame",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Exams"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exame cadastrado com sucesso"
          },
          "500": {
            "description": "Erro ao cadastrar exame"
          }
        }
      }
    },
    "/types/delete-examtype": {
      "delete": {
        "summary": "Deletar um tipo de exame por nome ou ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteExamType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de exame deletado com sucesso"
          },
          "400": {
            "description": "Nome ou ID é necessário"
          },
          "404": {
            "description": "Tipo de exame não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    },
    "/result-types": {
      "get": {
        "summary": "Listar todos os tipos de resultados",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tipos de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultType"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo tipo de resultado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de resultado cadastrado com sucesso"
          },
          "400": {
            "description": "Erro no cadastro do tipo de resultado"
          }
        }
      }
    },
    "/result-types/delete-resulttype": {
      "delete": {
        "summary": "Deletar um tipo de resultado por nome ou ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteResultType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo de resultado deletado com sucesso"
          },
          "400": {
            "description": "Nome ou ID é necessário"
          },
          "404": {
            "description": "Tipo de resultado não encontrado"
          },
          "500": {
            "description": "Erro no servidor"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "auth": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ForgotPassword": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ResetPassword": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "ExamType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ResultType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "measures": {
            "type": "string"
          }
        }
      },
      "Exams": {
        "type": "object",
        "properties": {
          "examName": {
            "type": "string"
          },
          "examDate": {
            "type": "string",
            "format": "date"
          },
          "examType": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selectedName": {
                  "type": "string"
                },
                "resultValue": {
                  "type": "string"
                },
                "selectedMeasure": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "DeleteExamType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "DeleteResultType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
